#!/bin/sh /etc/rc.common
# procd service for the Warren agent. Register first with `warren up`.

START=95
STOP=10
USE_PROCD=1

PROG=/usr/bin/warren

start_service() {
	if [ ! -f /etc/warren/agent.conf ]; then
		echo "warren: not registered yet; run: warren up --server <url> --token <token>" >&2
		return 1
	fi
	procd_open_instance
	procd_set_param command "$PROG" run
	# Restart forever, 5 s apart; the agent itself retries network errors.
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
